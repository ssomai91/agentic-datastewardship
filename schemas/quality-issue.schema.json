{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninetyone.internal/schemas/quality-issue.schema.json",
  "title": "Quality Issue Record",
  "description": "Minimum record for a quality issue routed to a human, with the fields the DMBOK2 lists for tracked issues. The decision owner is a business data owner. An agent never fills in a decision.",
  "type": "object",
  "required": ["issue_id", "description", "root_causes", "remediation_options", "decision", "decision_owner"],
  "additionalProperties": false,
  "properties": {
    "issue_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "root_causes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "remediation_options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decision": { "type": "string", "minLength": 1, "description": "Pending until a human decides." },
    "decision_owner": { "type": "string", "minLength": 1 },
    "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
