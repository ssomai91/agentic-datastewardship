{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninetyone.internal/schemas/outputs/stewardship-agent-architect.output.schema.json",
  "title": "Stewardship Agent Architect output",
  "type": "object",
  "required": ["summary", "classification", "necessity_verdict", "justification", "evidence", "assumptions", "open_questions", "recommendations", "human_action_required", "handoff"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "classification": { "type": "string", "enum": ["Human responsibility", "Deterministic process", "AI-assisted workflow", "Specialised AI agent", "Multi-agent workflow"] },
    "necessity_verdict": { "type": "string", "enum": ["keep", "cut", "merge", "redesign", "defer"] },
    "justification": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "$ref": "../evidence.schema.json" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "evaluation_outline_pointer": { "type": "string", "minLength": 1 },
    "draft_agent_contract": { "type": "string", "minLength": 1 },
    "human_action_required": { "type": "array", "items": { "type": "string" } },
    "handoff": { "$ref": "../agent-handoff.schema.json" }
  }
}